#derive(Eq, @debug.Debug)
pub(all) struct WaySet {
  kind : String
  at : Double
  made : String
  part : String
}

#derive(Eq, @debug.Debug)
pub(all) struct Wheel {
  x : Double
  y : Double
  wx : Double
  wy : Double
  dx : Double
  dy : Double
  mods : Int32
  at : Double
  w : Double
  h : Double
}

pub(all) struct WheelLast {
  mut found_at : Int32
  mut found_gen : Int32
  mut took_at : Int32
  mut took_gen : Int32
}

#derive(Eq, @debug.Debug)
pub(all) struct WordsLook {
  size : Double
  weight : Int32
  line : Double
  wrap : Bool
  tracking : Spacing
  balance : Bool
  max_lines : Int32
}

#derive(Eq, @debug.Debug)
pub(all) struct Work {
  mut besides : Int32
  mut made : Int32
  mut let_go : Int32
  mut bound : Int32
  mut same : Int32
  mut computes : Int32
  mut laid : Int32
  mut visited : Int32
  mut measured : Int32
  mut instances : Int32
  mut composed : Int32
  mut changes : Int32
  mut orders : Int32
  mut boxes_walked : Int32
  mut structure : Int32
  mut pulled : Int32
  mut drawn_boxes : Int32
  mut settles : Int32
  mut found_walked : Int32
  mut near_kept : Int32
  mut inputs_walked : Int32
  mut order_copied : Int32
  mut passes : Int32
  again : FixedArray[Int32]
}

